<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- IMPL-A §1.3: hand-written (GENERATE_INFOPLIST_FILE = NO), every key a reason. CFBundleVersion is stamped by tools/app-bundle.sh
	     (the commit count, §7.1); no NSAppTransportSecurity (nothing loads from the network, A2); no UIRequiresFullScreen (§6.3). -->
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>SYNTH</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key><string>Default</string>
					<key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- the launch screen is the site's background colour only (§1.4): the page paints in ≈ 1 s; a logo that then jumps would be worse -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key><string>LaunchBackground</string>
	</dict>
	<key>UIStatusBarHidden</key><true/>
	<key>UIViewControllerBasedStatusBarAppearance</key><true/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Q2: the mode is always declared; the "Sound in background" setting in the page decides whether the context keeps running (§5.2) -->
	<key>UIBackgroundModes</key>
	<array><string>audio</string></array>
	<!-- the app's Documents in the Files app (On My iPad › SYNTH) — the reviewers' way to put files on the simulator (§4.2, §9.2) -->
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<!-- Files' Share → SYNTH / Open in for project and MIDI files (§4.3); Alternate: not the default app for JSON -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>SYNTH project</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>public.json</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>MIDI file</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>public.midi-audio</string></array>
		</dict>
	</array>
	<!-- the wavetable editor's image picker (accept .png,image/png) makes WebKit's upload menu offer Take Photo; without this key the
	     system kills the app on that tap (§1.3 — device-only; added on principle) -->
	<key>NSCameraUsageDescription</key><string>SYNTH can use a photo you take as a wavetable image.</string>
	<!-- (fix R1-F2) an audio/* accept (the IR, drum-sample and wavetable-sample pickers) makes WebKit's upload menu offer Take Video,
	     which records sound: without this key the system kills the app on that tap (device-only, as the camera's) -->
	<key>NSMicrophoneUsageDescription</key><string>SYNTH does not record audio; iPadOS asks only if you choose Take Video in a file picker.</string>
	<!-- IMPL-B §4.1: the Bluetooth MIDI pairing sheet (CABTMIDICentralViewController) starts CoreBluetooth — without this key the system
	     kills the app when it opens (iOS 13+; device-only — the simulator has no Bluetooth). Our code never imports CoreBluetooth (B3). -->
	<key>NSBluetoothAlwaysUsageDescription</key><string>SYNTH connects to Bluetooth MIDI keyboards and pads you pair here.</string>
</dict>
</plist>
